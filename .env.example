# vanDyke — configuration reference. Copy to .env and adjust.

# HTTP port the server listens on.
PORT=8080

# SQLite database location. In Docker this should live on the volume, e.g. /data/vandyke.db
DB_PATH=./data/vandyke.db

# Set to true when running behind a reverse proxy you control, so that
# X-Forwarded-For is trusted for client IPs and rate limiting.
TRUST_PROXY=false

# Per-IP budget for adding entries. Applies to both the web form and the API.
ADD_RATE_LIMIT_PER_HOUR=10
ADD_RATE_LIMIT_BURST=5

# Self-hosted Umami analytics. Leave both empty to disable analytics entirely.
# UMAMI_URL points at your instance's tracker script, e.g. https://umami.example.com/script.js
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Optional comma-separated hostnames that Umami should track, e.g. vandyke.thor.edu
UMAMI_DOMAINS=

# Admin interface. The first admin is created at /admin/setup. Set a token to
# require it before the instance is exposed; otherwise the first visitor can
# claim the instance.
ADMIN_SETUP_TOKEN=

# Login brute-force budget per IP.
ADMIN_LOGIN_RATE_PER_MINUTE=10
ADMIN_LOGIN_RATE_BURST=5

# Optional OpenID Connect login. Any identity accepted by the provider becomes
# an admin. Leave empty to use local username/password only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional fixed callback URL; derived from the request when empty.
OIDC_REDIRECT_URL=
