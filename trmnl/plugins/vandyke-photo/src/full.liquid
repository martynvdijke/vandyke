{% comment %}Newest vanDyke photo entry{% endcomment %}
<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item"><div class="content"><div class="value value--base">{{ error }}</div></div></div>
  {% else %}
    {% if has_photo %}
      <div class="item"><img class="image image-cover image-dither rounded" src="{{ photo_url }}" alt="Photo of a misspelling" /></div>
      <div class="item">
        <div class="content">
          <div class="flex flex--row flex--between">
            <span class="value value--small">{% if word %}{{ word }}{% else %}photo entry{% endif %}</span>
            <span class="label label--small">{{ date }}</span>
          </div>
          <div class="label">→ {% if meaning %}{{ meaning }}{% else %}photo entry{% endif %}</div>
        </div>
      </div>
    {% else %}
      <div class="item"><div class="content"><div class="value value--base">{{ message }}</div><div class="label label--small">{{ total }} entries in the ledger</div></div></div>
    {% endif %}
  {% endif %}
</div>
<div class="title_bar"><span class="title">vanDyke</span><span class="instance">photo</span></div>
