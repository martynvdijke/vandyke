<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item"><div class="content"><div class="value value--small">{{ error }}</div></div></div>
  {% else %}
    {% for e in entries %}
      <div class="item"><div class="content"><div class="value value--small">{% if e.word %}{{ e.word }}{% else %}photo entry{% endif %}</div><div class="label label--small">→ {% if e.meaning %}{{ e.meaning }}{% else %}photo{% endif %} · {{ e.date }}</div></div></div>
      {% unless forloop.last %}<div class="hr"></div>{% endunless %}
    {% endfor %}
  {% endif %}
</div>
<div class="title_bar"><span class="title">vanDyke</span><span class="instance">latest</span></div>
