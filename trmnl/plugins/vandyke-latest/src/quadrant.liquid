<div class="layout layout--col gap--small">
  {% if error %}
    <div class="item"><div class="content"><div class="value value--small">{{ error }}</div></div></div>
  {% else %}
    <div class="item"><div class="content"><div class="label label--small">vanDyke · latest</div></div></div>
    {% for e in entries limit:2 %}
      <div class="item"><div class="content"><span class="value value--small">{% if e.word %}{{ e.word }}{% else %}photo{% endif %}</span><div class="label label--small">→ {% if e.meaning %}{{ e.meaning }}{% else %}photo{% endif %}</div></div></div>
    {% endfor %}
  {% endif %}
</div>
