<div class="layout layout--row layout--stretch gap">
  {% if error %}
    <div class="item"><div class="content"><div class="value value--small">{{ error }}</div></div></div>
  {% else %}
    <div class="item"><div class="content"><div class="value value--large">{{ total }}</div><div class="label label--small">entries</div></div></div>
    <div class="item"><div class="content"><div class="value value--large">{{ unique }}</div><div class="label label--small">unique</div></div></div>
    <div class="item"><div class="content"><div class="value value--large">{{ last30 }}</div><div class="label label--small">30 days</div></div></div>
    <div class="item"><div class="content"><div class="label label--small">Latest</div><div class="label label--small">{% if entries[0].word %}{{ entries[0].word }}{% else %}photo{% endif %} → {% if entries[0].meaning %}{{ entries[0].meaning }}{% else %}photo{% endif %}</div></div></div>
    {% if has_photo %}<div class="item"><img class="image image-cover image-dither rounded" src="{{ photo.photo_url }}" alt="Photo of a misspelling" /></div>{% endif %}
  {% endif %}
</div>
<div class="title_bar"><span class="title">vanDyke</span><span class="instance">dashboard</span></div>
